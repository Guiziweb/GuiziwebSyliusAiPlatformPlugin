<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="guiziweb_sylius_ai_platform.behat.page.admin.provider.index" class="Sylius\Behat\Page\Admin\Crud\IndexPage" parent="sylius.behat.page.admin.crud.index">
            <argument>guiziweb_sylius_ai_platform_admin_provider_index</argument>
        </service>

        <service id="guiziweb_sylius_ai_platform.behat.page.admin.provider.create" class="Tests\Guiziweb\SyliusAiPlatformPlugin\Behat\Page\Admin\Provider\CreatePage" parent="sylius.behat.page.admin.crud.create">
            <argument>guiziweb_sylius_ai_platform_admin_provider_create</argument>
        </service>

        <service id="guiziweb_sylius_ai_platform.behat.page.admin.provider.update" class="Tests\Guiziweb\SyliusAiPlatformPlugin\Behat\Page\Admin\Provider\UpdatePage" parent="sylius.behat.page.admin.crud.update">
            <argument>guiziweb_sylius_ai_platform_admin_provider_update</argument>
        </service>

        <service id="guiziweb_sylius_ai_platform.behat.context.setup.provider" class="Tests\Guiziweb\SyliusAiPlatformPlugin\Behat\Context\Setup\ProviderContext">
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <service id="guiziweb_sylius_ai_platform.behat.context.ui.admin.managing_providers" class="Tests\Guiziweb\SyliusAiPlatformPlugin\Behat\Context\Ui\Admin\ManagingProvidersContext">
            <argument type="service" id="guiziweb_sylius_ai_platform.behat.page.admin.provider.create" />
            <argument type="service" id="guiziweb_sylius_ai_platform.behat.page.admin.provider.update" />
            <argument type="service" id="guiziweb_sylius_ai_platform.behat.page.admin.provider.index" />
            <argument type="service" id="sylius.behat.element.admin.notifications" />
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>
    </services>
</container>
